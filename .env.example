# Neon PostgreSQL (gunakan connection string pooled untuk runtime Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — generate dengan: openssl rand -base64 32
# Juga dipakai mengenkripsi Midtrans key per organisasi
AUTH_SECRET="ganti-dengan-secret-acak"
AUTH_URL="http://localhost:3000"

# Fonnte WhatsApp API (tingkat platform)
FONNTE_TOKEN=""

# Proteksi Vercel Cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="ganti-dengan-secret-acak"

# Midtrans milik pemilik kos (model B) diisi di Pengaturan, bukan di env.
# Langganan SaaS (Free/Pro) memakai akun Midtrans platform SiniKos.
# Sandbox dulu. Set true hanya jika key Production dan siap uang sungguhan.
PLATFORM_MIDTRANS_SERVER_KEY=""
PLATFORM_MIDTRANS_IS_PRODUCTION="false"
