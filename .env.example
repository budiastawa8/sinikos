# Neon PostgreSQL (gunakan connection string pooled untuk runtime Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — generate dengan: openssl rand -base64 32
# Juga dipakai mengenkripsi Midtrans key per organisasi
AUTH_SECRET="ganti-dengan-secret-acak"
AUTH_URL="http://localhost:3000"

# WhatsApp platform — pilih provider: fonnte | meta | custom (default: fonnte)
WHATSAPP_PROVIDER="fonnte"

# --- fonnte (default) ---
# Token Device (menu Device di md.fonnte.com), BUKAN Account Token di Settings.
# Tanpa tanda kutip / tanpa prefix "Bearer ". Perangkat harus connect.
FONNTE_TOKEN=""

# --- meta (WhatsApp Cloud API resmi) ---
# WHATSAPP_PROVIDER=meta
# WHATSAPP_META_ACCESS_TOKEN=""
# WHATSAPP_META_PHONE_NUMBER_ID=""
# WHATSAPP_META_API_VERSION="v21.0"
# Opsional: template Utility (1 variabel body) untuk outbound di luar jendela 24 jam
# WHATSAPP_META_TEMPLATE_NAME=""
# WHATSAPP_META_TEMPLATE_LANG="id"

# --- custom (gateway HTTP sendiri) ---
# WHATSAPP_PROVIDER=custom
# POST JSON { "phone": "628…", "message": "…" }; auth opsional Bearer
# WHATSAPP_GATEWAY_URL="https://gateway.contoh.com/send"
# WHATSAPP_GATEWAY_TOKEN=""

# Kuota pesan WA terkirim per org per bulan kalender
PLATFORM_WA_FREE_MONTHLY_QUOTA="10"
PLATFORM_WA_MONTHLY_QUOTA="200"
PLATFORM_WA_PRO_PLUS_MONTHLY_QUOTA="500"

# Proteksi Vercel Cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="ganti-dengan-secret-acak"

# Midtrans milik pemilik kos (model B) diisi di Pengaturan, bukan di env.
# Langganan SaaS (Free/Pro) memakai akun Midtrans platform SiniKos.
# Sandbox dulu. Set true hanya jika key Production dan siap uang sungguhan.
PLATFORM_MIDTRANS_SERVER_KEY=""
PLATFORM_MIDTRANS_IS_PRODUCTION="false"
